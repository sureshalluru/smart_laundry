# ============================================================
# Smart Laundry Basket — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database (REQUIRED) ──────────────────────────────────────
# Option 1: Full connection URL (preferred)
DATABASE_URL=postgresql://user:password@localhost:5432/smart_laundry

# Option 2: Individual components (used if DATABASE_URL is default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_laundry
DB_USER=postgres
DB_PASSWORD=your_password

# ── Authentication (REQUIRED) ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# ── Google Maps (REQUIRED for address features) ──────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=

# Also set this for the React frontend builds:
REACT_APP_GOOGLE_MAPS_API_KEY=

# ── Stripe (for payments) ────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Each business connects their own Stripe account during onboarding
STRIPE_SECRET_KEY=

# ── Twilio (for SMS OTP login) ───────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_VERIFY_SERVICE_SID=

# ── Brevo / SendinBlue (for email) ──────────────────────────
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
SOURCE_EMAIL=noreply@yourdomain.com

# ── AWS S3 (for image uploads) ───────────────────────────────
# Create 3 buckets: logos, review-images, item-tracking
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_LOGO_BUCKET=your-logo-bucket
S3_REVIEW_BUCKET=your-review-bucket
S3_TRACKING_BUCKET=your-tracking-bucket

# ── Anthropic Claude (for AI item tracking) ──────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Uber Direct (for delivery integration) ───────────────────
# Get from: https://developer.uber.com/
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=

# ── CORS (adjust for your domain) ───────────────────────────
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# ── Development Flags ────────────────────────────────────────
# Set to 1 to skip on local dev (faster startup)
# SKIP_SCHEDULER=1
# SKIP_MIGRATIONS=1
